/**
 * Google Ads 脚本：拉取过去7天花费前10的广告系列并计算环比变化 
 */

var EMAIL_ADDRESS = '';

function main() {
  var accountTimeZone = AdsApp.currentAccount().getTimeZone();
  
  // 计算日期范围
  // 当前7天：过去第7天到过去第1天
  var startDateCurrent = getFormattedDate(7, accountTimeZone);
  var endDateCurrent = getFormattedDate(1, accountTimeZone);
  
  // 环比7天：过去第14天到过去第8天
  var startDatePrev = getFormattedDate(14, accountTimeZone);
  var endDatePrev = getFormattedDate(8, accountTimeZone);

  // 1. 查询过去7天花费Top 10 的广告系列 (已移除 metrics.conversions)
  var queryCurrent = "SELECT campaign.id, campaign.name, metrics.cost_micros, metrics.conversions_value " +
                     "FROM campaign " +
                     "WHERE segments.date BETWEEN '" + startDateCurrent + "' AND '" + endDateCurrent + "' " +
                     "ORDER BY metrics.cost_micros DESC LIMIT 10";
  
  var reportCurrent = AdsApp.search(queryCurrent);
  
  var topCampaigns = {};
  var campaignIds = [];
  
  while (reportCurrent.hasNext()) {
    var row = reportCurrent.next();
    var id = row.campaign.id;
    var cost = row.metrics.costMicros / 1000000;
    var convValue = row.metrics.conversionsValue;
    var roas = cost > 0 ? (convValue / cost) : 0;
    
    topCampaigns[id] = {
      name: row.campaign.name,
      cost1: cost,
      val1: convValue,
      roas1: roas,
      cost2: 0,
      val2: 0,
      roas2: 0
    };
    campaignIds.push(id);
  }
  
  if (campaignIds.length === 0) {
    Logger.log("过去7天没有产生花费的广告系列。");
    return;
  }
  
  // 2. 查询这些广告系列在再之前7天的环比数据
  var idsString = campaignIds.join(",");
  var queryPrev = "SELECT campaign.id, metrics.cost_micros, metrics.conversions_value " +
                  "FROM campaign " +
                  "WHERE campaign.id IN (" + idsString + ") " +
                  "AND segments.date BETWEEN '" + startDatePrev + "' AND '" + endDatePrev + "'";
                  
  var reportPrev = AdsApp.search(queryPrev);
  
  while (reportPrev.hasNext()) {
    var row = reportPrev.next();
    var id = row.campaign.id;
    
    if (topCampaigns[id]) {
      var cost = row.metrics.costMicros / 1000000;
      var convValue = row.metrics.conversionsValue;
      var roas = cost > 0 ? (convValue / cost) : 0;
      
      topCampaigns[id].cost2 = cost;
      topCampaigns[id].val2 = convValue;
      topCampaigns[id].roas2 = roas;
    }
  }
  
  // 3. 构建邮件 HTML 内容
  var htmlBody = "<h2 style='color:#4285F4;'>预算主要流向</h2>";
  htmlBody += "<table border='1' cellpadding='8' cellspacing='0' style='border-collapse: collapse; text-align: right; width: 100%; font-family: Arial, sans-serif;'>";
  htmlBody += "<tr style='background-color: #f2f2f2; text-align: center;'>" +
              "<th>广告系列名称</th>" +
              "<th>花费</th><th>花费环比</th>" +
              "<th>转化价值</th><th>转化价值环比</th>" +
              "<th>ROAS</th><th>ROAS环比</th>" +
              "</tr>";
              
  for (var i = 0; i < campaignIds.length; i++) {
    var id = campaignIds[i];
    var data = topCampaigns[id];
    
    htmlBody += "<tr>";
    htmlBody += "<td style='text-align: left;'>" + data.name + "</td>";
    
    // 花费
    htmlBody += "<td>$" + data.cost1.toFixed(2) + "</td>";
    htmlBody += getWowCell(data.cost1, data.cost2);
    
    // 转化价值
    htmlBody += "<td>$" + data.val1.toFixed(2) + "</td>";
    htmlBody += getWowCell(data.val1, data.val2);
    
    // ROAS
    htmlBody += "<td>" + data.roas1.toFixed(2) + "</td>";
    htmlBody += getWowCell(data.roas1, data.roas2);
    
    htmlBody += "</tr>";
  }
  
  htmlBody += "</table>";
  htmlBody += "<p style='font-size: 12px; color: #888;'>此邮件由 Google Ads 脚本自动生成。</p>";
  
  // 4. 发送邮件
  MailApp.sendEmail({
    to: EMAIL_ADDRESS,
    subject: "Google Ads Top 花费广告系列 ",
    htmlBody: htmlBody
  });
  
  Logger.log("报告已成功生成并发送至 " + EMAIL_ADDRESS);
}

// 辅助函数：计算环比变化百分比，并带有颜色高亮
function getWowCell(current, prev) {
  var wowText = "";
  var color = "#000000";
  
  if (prev === 0) {
    if (current > 0) {
      wowText = "+∞%";
      color = "green";
    } else {
      wowText = "0.00%";
      color = "#666";
    }
  } else {
    var wow = ((current - prev) / prev) * 100;
    var sign = wow > 0 ? "+" : "";
    wowText = sign + wow.toFixed(2) + "%";
    
    if (wow > 0) color = "green"; // 增长显示绿色
    else if (wow < 0) color = "red"; // 下降显示红色
    else color = "#666";
  }
  
  return "<td style='color: " + color + "; font-weight: bold;'>" + wowText + "</td>";
}

// 辅助函数：获取指定天数前的格式化日期 (YYYY-MM-DD)
function getFormattedDate(daysAgo, timeZone) {
  var date = new Date();
  date.setDate(date.getDate() - daysAgo);
  return Utilities.formatDate(date, timeZone, 'yyyy-MM-dd');
}
