/**
 * Google Ads 质量得分监控脚本 
 */

// ================= 配置区域 =================
const EMAIL_ADDRESS = ""; 此处改成你的邮箱地址
// ===========================================

function main() {
  const reportData = getKeywordPerformance();
  
  if (reportData.length > 0) {
    sendEmailReport(reportData);
  } else {
    Logger.log("⚠️ 警告：在过去 30 天内未找到点击量 > 1 的关键词。请检查账户是否有消耗。");
  }
}

function getKeywordPerformance() {
  // 获取日期范围：从昨天起往前推 30 天
  const timeZone = AdsApp.currentAccount().getTimeZone();
  const endDate = new Date();
  endDate.setDate(endDate.getDate() - 1); // 昨天
  const startDate = new Date();
  startDate.setDate(startDate.getDate() - 30); // 30天前
  
  const startStr = Utilities.formatDate(startDate, timeZone, 'yyyyMMdd');
  const endStr = Utilities.formatDate(endDate, timeZone, 'yyyyMMdd');
  
  Logger.log(`>>> 正在统计日期范围: ${startStr} 至 ${endStr}`);

  // 1. 获取指标数据 (移除了 conversions_value)
  const metricsQuery = `
    SELECT 
      ad_group_criterion.resource_name,
      ad_group_criterion.keyword.text, 
      metrics.ctr, 
      metrics.clicks, 
      metrics.impressions, 
      metrics.conversions, 
      metrics.cost_micros, 
      campaign.name,
      ad_group.name
    FROM keyword_view 
    WHERE 
      metrics.clicks > 1 
      AND segments.date BETWEEN '${startStr}' AND '${endStr}'
      AND ad_group_criterion.status = 'ENABLED'
      AND campaign.status = 'ENABLED'`;

  const metricsRows = AdsApp.search(metricsQuery);
  const keywordMap = {};
  const resourceNames = [];

  while (metricsRows.hasNext()) {
    const row = metricsRows.next();
    const resName = row.adGroupCriterion.resourceName;
    resourceNames.push(resName);
    
    const cost = row.metrics.costMicros / 1000000;
    const conversions = row.metrics.conversions;
    
    // 计算 CPA (Cost / Conversions)
    const cpa = conversions > 0 ? (cost / conversions).toFixed(2) : "0.00";

    keywordMap[resName] = {
      keyword: row.adGroupCriterion.keyword.text,
      ctr: (row.metrics.ctr * 100).toFixed(2) + "%",
      clicks: parseInt(row.metrics.clicks),
      impressions: row.metrics.impressions,
      conversions: conversions,
      cost: cost.toFixed(2),
      cpa: cpa,
      campaign: row.campaign.name,
      adGroup: row.adGroup.name
    };
  }

  Logger.log(`找到符合条件的关键词总数: ${resourceNames.length}`);

  if (resourceNames.length === 0) return [];

  // 2. 获取质量得分属性 (分批查询)
  const finalData = [];
  const chunkSize = 1000;
  for (let i = 0; i < resourceNames.length; i += chunkSize) {
    const chunk = resourceNames.slice(i, i + chunkSize);
    const qsQuery = `
      SELECT 
        ad_group_criterion.resource_name,
        ad_group_criterion.quality_info.quality_score,
        ad_group_criterion.quality_info.post_click_quality_score,
        ad_group_criterion.quality_info.creative_quality_score,
        ad_group_criterion.quality_info.search_predicted_ctr
      FROM ad_group_criterion 
      WHERE ad_group_criterion.resource_name IN ('${chunk.join("','")}')`;

    const qsRows = AdsApp.search(qsQuery);
    while (qsRows.hasNext()) {
      const qsRow = qsRows.next();
      const resName = qsRow.adGroupCriterion.resourceName;
      const qInfo = qsRow.adGroupCriterion.qualityInfo;
      
      const item = keywordMap[resName];
      if (item && qInfo) {
        item.qs = qInfo.qualityScore || 0;
        item.landingPage = translateStatus(qInfo.postClickQualityScore);
        item.expCtr = translateStatus(qInfo.searchPredictedCtr);
        item.relevance = translateStatus(qInfo.creativeQualityScore);
        finalData.push(item);
      }
    }
  }

  // 按点击量降序排序
  finalData.sort((a, b) => b.clicks - a.clicks);
  return finalData;
}

function translateStatus(status) {
  const map = {
    'BELOW_AVERAGE': '低于平均',
    'AVERAGE': '平均水平',
    'ABOVE_AVERAGE': '高于平均',
    'UNKNOWN': '--',
    'UNSPECIFIED': '--'
  };
  return map[status] || status;
}

function sendEmailReport(data) {
  let htmlBody = `
    <html><body>
      <h2 style="color: #333;">Google Ads 质量得分报告 (近30天)</h2>
      <table border="1" style="border-collapse: collapse; font-family: sans-serif; font-size: 11px; width: 100%;">
        <tr style="background-color: #4285F4; color: white;">
          <th style="padding: 8px;">关键词</th><th>QS</th><th>CTR</th><th>点击</th><th>展示</th><th>转化</th><th>花费</th><th>CPA</th><th>着陆页</th><th>预期CTR</th><th>相关性</th>
        </tr>`;

  data.forEach(item => {
    const bgColor = item.qs < 5 ? '#ffebee' : 'white';
    const textColor = item.qs < 5 ? '#c62828' : '#000';
    htmlBody += `
      <tr style="background-color: ${bgColor}; color: ${textColor}; text-align: center;">
        <td style="text-align: left; padding: 5px;">${item.keyword}</td>
        <td><b>${item.qs}</b></td><td>${item.ctr}</td><td>${item.clicks}</td><td>${item.impressions}</td><td>${item.conversions}</td><td>${item.cost}</td><td>${item.cpa}</td><td>${item.landingPage}</td><td>${item.expCtr}</td><td>${item.relevance}</td>
      </tr>`;
  });

  htmlBody += `</table></body></html>`;

  MailApp.sendEmail({
    to: EMAIL_ADDRESS,
    subject: "Google Ads 质量得分报告",
    htmlBody: htmlBody
  });
  Logger.log("报告已发送。");
}
